# Neon database connection strings
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.neon.tech/<dbname>?sslmode=require"
DEBUG_ENDPOINTS=true

# JWT signing (separate random values)
JWT_ACCESS_SECRET="<random>"
JWT_REFRESH_SECRET="<random>"

# Cloudinary (signing, backend uploads and deletes)
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"

# Gemini: comma-separated keys from separate Google Cloud projects
GEMINI_API_KEYS="<key1>,<key2>"
GEMINI_MODEL_TAG="<model>"
GEMINI_MODEL_RANK="<model>"

# Cloudflare Workers AI (outfit images)
CF_ACCOUNT_ID="<account-id>"
CF_API_TOKEN="<token>"
CF_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-9b"
CF_IMAGE_WIDTH=768
CF_IMAGE_HEIGHT=1024

# Seed only: password for admin@email.com
SEED_PASSWORD="<password>"
